# Copy to .env (repo root). Every setting is optional; defaults shown.
# All variables are prefixed TW_.

# SQLAlchemy URL. Local dev defaults to SQLite at var/tw.db.
# Production: postgresql+psycopg://user:pass@host/takedown_watch
# TW_DATABASE_URL=sqlite:///var/tw.db

# Where content-addressed raw HTML/XML blobs are written.
# TW_BLOB_DIR=var/blobs

# Contact URL embedded in the User-Agent. Must be reachable by outlet admins.
# TW_CONTACT_URL=https://activaterights.org

# Label recorded on every fetch. Name the machine/network the crawl runs from.
# TW_VANTAGE=local

# Minimum seconds between requests to one host (per-outlet override in outlets.yaml).
# TW_DEFAULT_RATE_LIMIT_SECONDS=2.0

# TW_HTTP_TIMEOUT_SECONDS=30
# TW_HTTP_MAX_ATTEMPTS=3

# Pending organisational decision; see CLAUDE.md "Operational notes".
# TW_RESPECT_RETROACTIVE_ROBOTS=false

# Internet Archive S3-style keys (https://archive.org/account/s3.php).
# Leave unset to use anonymous Save Page Now.
# TW_IA_ACCESS_KEY=
# TW_IA_SECRET_KEY=

# console | json
# TW_LOG_FORMAT=console
# TW_LOG_LEVEL=INFO
