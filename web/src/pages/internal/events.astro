---
// Internal M2 event dashboard. NOT part of the public site.
//
// Gating: this path must be protected by Cloudflare Access (see docs/m1-proposal.md) -- Astro
// itself does no auth here. CLAUDE.md: "Full event dashboard, authenticated" is permitted for
// M2-M3; "Publish nothing about specific outlets until [the M4 editorial] policy exists" is not
// optional. If dist/ is ever pushed to the project's public git mirror (CLAUDE.md "must be
// rehostable"), this page and data/internal/ must be excluded from that push.
import { loadInternalEvents } from "../../schemas/internal.ts";
import { diffWords } from "../../lib/diffWords.ts";

export const prerender = true; // static: no live DB access from the Cloudflare Worker runtime

const data = loadInternalEvents();
const events = data.events;

function badge(confidence: string): string {
  return confidence === "confirmed" ? "conf-confirmed" : confidence === "probable" ? "conf-probable" : "conf-unverified";
}

type Ev = (typeof events)[number];

const MAX_VERSIONS_PER_ARTICLE = 20; // must match pipeline/src/tw/export_internal.py

/** Dashboard is read in Dhaka -- show times there, not UTC, labelled so it's unambiguous. */
function dhaka(iso: string): string {
  const d = new Date(iso);
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Dhaka", year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hour12: false,
  }).formatToParts(d);
  const get = (t: string) => parts.find((p) => p.type === t)?.value ?? "";
  return `${get("year")}-${get("month")}-${get("day")} ${get("hour")}:${get("minute")}`;
}

/** Only the field(s) that actually produced this event -- not every field on the article. */
function whatChanged(e: Ev) {
  switch (e.type) {
    case "HEADLINE_CHANGED":
      return [{ before: e.from_headline, after: e.to_headline }];
    case "BYLINE_CHANGED":
    case "BYLINE_REMOVED":
      return [{ before: e.from_byline, after: e.to_byline }];
    case "DATE_CHANGED":
      return [{ before: e.from_published_at, after: e.to_published_at }];
    case "REDIRECTED":
      return [{ before: e.from_final_url, after: e.to_final_url }];
    case "BODY_CHANGED":
      return e.body_diff ? [{ diff: e.body_diff }] : [];
    default:
      return []; // GONE_*, DEINDEXED, UNPUBLISHED, RESTORED, ROBOTS_BLOCKED: no before/after
      // snapshot field is the signal -- the event type itself is the fact.
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Takedown Watch — internal event dashboard</title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: system-ui, sans-serif; margin: 0; padding: 1.5rem; background: #0b0d0a; color: #e8ece4; }
      h1 { font-size: 1.25rem; margin: 0 0 0.25rem; }
      .meta { color: #9aa294; font-size: 0.85rem; margin-bottom: 1.25rem; }
      .table-wrap { overflow-x: auto; border: 1px solid #262a22; border-radius: 0.4rem; }
      table { width: 100%; border-collapse: collapse; font-size: 0.85rem; table-layout: fixed; }
      th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #262a22; vertical-align: top; overflow: hidden; }
      th { color: #9aa294; font-weight: 600; position: sticky; top: 0; background: #0b0d0a; white-space: nowrap; }
      .col-sev { width: 3rem; }
      .col-detected { width: 7rem; }
      .col-outlet { width: 7rem; }
      .col-article { width: 10rem; }
      .col-type { width: 7rem; }
      .col-conf { width: 5.5rem; }
      .col-age { width: 4rem; }
      .col-diff { width: 20rem; }
      .col-review { width: 7rem; }
      .col-notes { width: 10rem; }
      .url-cell { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
      .change-badge {
        display: inline-block;
        font-size: 0.7rem;
        color: #e0c767;
        border: 1px solid #5a5340;
        border-radius: 1rem;
        padding: 0 0.4rem;
        margin-top: 0.2rem;
      }
      tr:hover { background: #14170f; }
      .type { font-weight: 600; }
      .age { color: #9aa294; white-space: nowrap; }
      .conf-confirmed { color: #7fd17f; }
      .conf-probable { color: #e0c767; }
      .conf-unverified { color: #c98a8a; }
      a { color: #8fb6e0; }
      .empty { color: #9aa294; padding: 2rem 0; }
      .sev { font-weight: 700; text-align: right; }
      .unreviewed { color: #9aa294; }
      .notes { margin: 0; padding-left: 1rem; }
      code { background: #14170f; padding: 0.1rem 0.3rem; border-radius: 3px; }
      .diff-cell { max-width: 32rem; }
      .diff-scroll {
        max-height: 10rem;
        overflow-y: auto;
        display: block;
      }
      .diff-scroll .old { color: #c98a8a; }
      .diff-scroll .new { color: #7fd17f; }
      .muted { color: #9aa294; }
      .body-diff {
        white-space: pre-wrap;
        word-break: break-word;
        font-family: inherit;
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.4;
      }
      .full-text summary {
        cursor: pointer;
        color: #8fb6e0;
        font-size: 0.8rem;
        padding: 0.25rem 0;
      }
      .full-text summary:hover { text-decoration: underline; }
      /* when open, the box below covers the page -- pin the toggle on top, in a fixed corner,
         so there's always a visible, clickable way to close it */
      .full-text[open] summary {
        position: fixed;
        top: 1rem;
        right: 2rem;
        z-index: 20;
        background: #1a1d16;
        border: 1px solid #5a6350;
        border-radius: 0.4rem;
        padding: 0.5rem 1rem;
        box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.5);
        font-weight: 600;
      }
      .full-text[open] summary::after { content: " ✕ close"; color: #c98a8a; }
      .full-text-block {
        position: fixed;
        inset: 3rem 2rem;
        z-index: 10;
        background: #0b0d0a;
        border: 1px solid #3a3e34;
        border-radius: 0.5rem;
        padding: 1.5rem;
        overflow-y: auto;
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.6);
      }
      .full-text-close { font-size: 0.8rem; margin: 0 0 1rem; }
      .archive-link { margin-left: 0.6rem; font-size: 0.75rem; font-weight: 400; color: #7fd17f; }
      .full-text-label {
        font-weight: 700;
        color: #e0c767;
        margin: 1.25rem 0 0.4rem;
        font-size: 0.85rem;
      }
      .full-text-label:first-child { margin-top: 0; }
      .full-text-body {
        white-space: pre-wrap;
        line-height: 1.6;
        font-size: 0.9rem;
        margin: 0;
        max-width: 48rem;
      }
      .full-text-body mark.del { background: #4a2020; color: #f0a6a6; text-decoration: line-through; }
      .full-text-body mark.ins { background: #1f3a20; color: #a6e0a6; }
      .side-by-side {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin: 1.25rem 0;
        padding-top: 1.25rem;
        border-top: 1px solid #262a22;
      }
      .side-by-side:first-child { border-top: none; padding-top: 0; }
      .side .full-text-body { max-width: none; }
      @media (max-width: 60rem) {
        .side-by-side { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <h1>Event dashboard</h1>
    <p class="meta">
      {events.length} events · generated {data.generated_at} · internal only, not for distribution
    </p>
    {events.length === 0 ? (
      <p class="empty">No events recorded yet. Run <code>tw recheck</code> / <code>tw crawl</code> against a tracked article a second time to generate one.</p>
    ) : (
      <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="col-sev">Sev</th>
            <th class="col-detected">Detected</th>
            <th class="col-outlet">Outlet</th>
            <th class="col-article">Article</th>
            <th class="col-type">Type</th>
            <th class="col-conf">Confidence</th>
            <th class="col-age">Age</th>
            <th class="col-diff">What changed</th>
            <th class="col-review">Review</th>
            <th class="col-notes">Notes</th>
          </tr>
        </thead>
        <tbody>
          {events.map((e) => (
            <tr>
              <td class="sev">{e.severity}</td>
              <td title={e.detected_at}>{dhaka(e.detected_at)} <span class="muted">BDT</span></td>
              <td>{e.outlet_name}</td>
              <td>
                <a class="url-cell" href={e.article_url} target="_blank" rel="noopener" title={e.article_url}>
                  {new URL(e.article_url).pathname}
                </a>
                {e.article_change_count > 1 && (
                  <span class="change-badge" title="total number of recorded changes for this article">
                    changed {e.article_change_count}×
                  </span>
                )}
              </td>
              <td class="type">{e.type}</td>
              <td class={badge(e.confidence)}>{e.confidence}</td>
              <td class="age">{e.article_age_at_change.toFixed(1)}h</td>
              <td class="diff-cell">
                <div class="diff-scroll">
                {(() => {
                  const changes = whatChanged(e);
                  if (changes.length === 0) return <span class="muted">— (see type)</span>;
                  return changes.map((c) =>
                    "diff" in c ? (
                      <div class="body-diff">{c.diff.split("\n").map((line) => (
                        <div class={line.startsWith("-") ? "old" : line.startsWith("+") ? "new" : ""}>{line}</div>
                      ))}</div>
                    ) : (
                      <>
                        <div class="old">− {c.before ?? "—"}</div>
                        <div class="new">+ {c.after ?? "—"}</div>
                      </>
                    ),
                  );
                })()}
                </div>
                {e.from_body && e.to_body && e.from_body !== e.to_body && (() => {
                  // word diff is O(n*m) -- cap it on very long bodies so the build stays fast;
                  // beyond that just show plain text, no highlight
                  const bothShort = e.from_body!.length < 20000 && e.to_body!.length < 20000;
                  const diffed = bothShort ? diffWords(e.from_body!, e.to_body!) : null;
                  return (
                    <details class="full-text">
                      <summary>Read full article text</summary>
                      <div class="full-text-block">
                        <div class="side-by-side">
                          <div class="side">
                            <p class="full-text-label">
                              Original (older version){e.from_fetched_at && <> — fetched {dhaka(e.from_fetched_at)} BDT</>}
                              {e.from_archive_url && (
                                <a class="archive-link" href={e.from_archive_url} target="_blank" rel="noopener">
                                  independent proof (Internet Archive copy)
                                </a>
                              )}
                            </p>
                            <p class="full-text-body">
                              {diffed
                                ? diffed.before.map((p) => p.tag === "del" ? <mark class="del">{p.text}</mark> : <>{p.text}</>)
                                : e.from_body}
                            </p>
                          </div>
                          <div class="side">
                            <p class="full-text-label">
                              Current (newer version){e.to_fetched_at && <> — fetched {dhaka(e.to_fetched_at)} BDT</>}
                              {e.to_archive_url && (
                                <a class="archive-link" href={e.to_archive_url} target="_blank" rel="noopener">
                                  independent proof (Internet Archive copy)
                                </a>
                              )}
                            </p>
                            <p class="full-text-body">
                              {diffed
                                ? diffed.after.map((p) => p.tag === "ins" ? <mark class="ins">{p.text}</mark> : <>{p.text}</>)
                                : e.to_body}
                            </p>
                          </div>
                        </div>
                      </div>
                    </details>
                  );
                })()}
                {e.article_versions.length > 2 && (() => {
                  const versions = e.article_versions;
                  return (
                    <details class="full-text">
                      <summary>See all {versions.length}{versions.length >= MAX_VERSIONS_PER_ARTICLE ? "+" : ""} versions of this article</summary>
                      <div class="full-text-block">
                        {versions.slice(1).map((v, idx) => {
                          const prev = versions[idx]!; // versions[idx] is the one before v (idx shifted by slice)
                          const bodyA = prev.body ?? "";
                          const bodyB = v.body ?? "";
                          const bothShort = bodyA.length < 20000 && bodyB.length < 20000;
                          const diffed = bothShort ? diffWords(bodyA, bodyB) : null;
                          const i = idx + 1;
                          return (
                            <div class="side-by-side">
                              <div class="side">
                                <p class="full-text-label">
                                  Version {i} of {versions.length} — fetched {dhaka(prev.fetched_at)} BDT
                                  {prev.archive_url && (
                                    <a class="archive-link" href={prev.archive_url} target="_blank" rel="noopener">
                                      independent proof (Internet Archive copy)
                                    </a>
                                  )}
                                </p>
                                <p class="full-text-body">
                                  {diffed
                                    ? diffed.before.map((p) => p.tag === "del" ? <mark class="del">{p.text}</mark> : <>{p.text}</>)
                                    : (prev.body ?? <span class="muted">(no text captured)</span>)}
                                </p>
                              </div>
                              <div class="side">
                                <p class="full-text-label">
                                  Version {i + 1} of {versions.length} — fetched {dhaka(v.fetched_at)} BDT
                                  {v.archive_url && (
                                    <a class="archive-link" href={v.archive_url} target="_blank" rel="noopener">
                                      independent proof (Internet Archive copy)
                                    </a>
                                  )}
                                </p>
                                <p class="full-text-body">
                                  {diffed
                                    ? diffed.after.map((p) => p.tag === "ins" ? <mark class="ins">{p.text}</mark> : <>{p.text}</>)
                                    : (v.body ?? <span class="muted">(no text captured)</span>)}
                                </p>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </details>
                  );
                })()}
              </td>
              <td>
                {e.reviewed_by ? (
                  <span>{e.review_decision} ({e.reviewed_by})</span>
                ) : (
                  <span class="unreviewed">unreviewed</span>
                )}
              </td>
              <td>
                {e.annotations.length === 0 ? "—" : (
                  <ul class="notes">
                    {e.annotations.map((a) => (
                      <li><strong>{a.author}:</strong> {a.body}</li>
                    ))}
                  </ul>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <p class="meta">
        Review via CLI: <code>tw review &lt;event_id&gt; --reviewed-by name --decision confirmed|dismissed|escalated</code>
        &nbsp;·&nbsp; annotate: <code>tw annotate &lt;event_id&gt; --author name --body "..."</code>
      </p>
    )}
  </body>
</html>
